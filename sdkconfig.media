# ESP32-S3 media configuration for the 4 MiB OTA slots (ADR-041/042).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_KVM_IME_KOREAN=n
# The LVGL showcase embeds benchmark photos in mapped PSRAM on the 7B.
# Keep that demo in the base engineering profile. The four KVMpad LCD
# benchmark scenes remain available while testing the media firmware.
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
