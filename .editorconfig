root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The frozen spec package (docs/spec/**, AGENTS*.md, reference/**) is LF/UTF-8 like the rest of the
# repository and is checksummed (docs/spec/MANIFEST-SHA256.md) — do not reformat it.
[{docs/spec/*.md,AGENTS.md,AGENTS-UI.md,reference/**}]
trim_trailing_whitespace = false
