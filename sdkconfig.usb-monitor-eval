# Apply after sdkconfig.defaults, sdkconfig.hpe and sdkconfig.media in a fresh
# four-interface configuration. sdkconfig.boot-hid already enables the receiver.
# The vendor interface is advertised only after an explicit display selection.
CONFIG_KVM_USB_MONITOR_EVAL=y
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_EPSIZE=64
