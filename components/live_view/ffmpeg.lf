[scheme:media_static_tables]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:media_avcodec]
archive: libavcodec.a
entries:
    if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (media_static_tables)

[mapping:media_avutil]
archive: libavutil.a
entries:
    if SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        * (media_static_tables)
