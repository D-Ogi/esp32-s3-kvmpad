config KVM_SSH_BOARD
    bool "Paired SSH keyboard and mouse on the device"
    depends on VFS_SUPPORT_IO
    select VFS_SUPPORT_TERMIOS
    default n
    help
        Enable the direct SSH endpoint with the existing paired TLS session and
        LCD control approval. Intended for board qualification.
