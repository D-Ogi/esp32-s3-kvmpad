{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kvmpad.dev/schemas/kvmpack-bindings-v1.json",
  "title": "KVMpad Bindings and Actions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources", "state", "connections", "actions"],
  "properties": {
    "version": {"const": 1},
    "sources": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "topic", "type", "max_age_ms"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "topic": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"},
          "type": {"enum": ["float", "int", "bool", "string"]},
          "default": {"type": ["number", "integer", "boolean", "string", "null"]},
          "max_age_ms": {"type": "integer", "minimum": 100, "maximum": 10000}
        }
      }
    },
    "state": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "initial"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "type": {"enum": ["float", "int", "bool", "string"]},
          "initial": {"type": ["number", "integer", "boolean", "string"]},
          "min": {"type": "number"},
          "max": {"type": "number"}
        }
      }
    },
    "connections": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "transform"],
        "properties": {
          "from": {"$ref": "#/$defs/name"},
          "to": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}\\.[a-z][a-z0-9_]{0,47}$"},
          "transform": {"enum": ["identity", "clamp", "scale", "offset", "round", "enum_map", "hysteresis", "lowpass", "format_number", "boolean_threshold"]},
          "params": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "min": {"type": "number"}, "max": {"type": "number"},
              "factor": {"type": "number"}, "amount": {"type": "number"},
              "low": {"type": "number"}, "high": {"type": "number"}, "threshold": {"type": "number"},
              "tau_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
              "digits": {"type": "integer", "minimum": 0, "maximum": 6},
              "entries": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
                "type": "object", "additionalProperties": false, "required": ["code", "label"],
                "properties": {"code": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
                               "label": {"type": "string", "minLength": 1, "maxLength": 48}}
              }}
            }
          }
        }
      }
    },
    "actions": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "trigger", "type", "capability", "args"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "trigger": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}\\.(press|release|change|drag|rotate|tap|long_press|step_up|step_down)$"},
          "type": {"enum": ["hid.key_tap", "hid.pointer_button", "hid.joystick.set_axes", "hid.radial.rotate", "host.command", "ui.navigate", "state.set", "state.adjust", "stream.start", "stream.stop"]},
          "capability": {"$ref": "#/$defs/permission"},
          "args": {"type": "object", "maxProperties": 16}
        },
        "if": {"properties": {"type": {"const": "state.adjust"}}},
        "then": {"properties": {
          "capability": {"const": "ui.basic"},
          "trigger": {"pattern": "\\.(step_up|step_down)$"},
          "args": {"required": ["name", "delta"], "additionalProperties": false,
                   "properties": {"name": {"$ref": "#/$defs/name"},
                                  "delta": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647, "not": {"const": 0}}}}
        }}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"},
    "permission": {"enum": ["ui.basic", "hid.keyboard", "hid.mouse", "hid.radial", "hid.joystick", "host.telemetry.read", "host.screen.region", "host.actions", "storage.profile.settings"]}
  }
}
