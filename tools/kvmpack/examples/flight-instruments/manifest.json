{
  "schema_version": 1,
  "id": "org.kvmpad.flight.instruments",
  "version": "1.0.0",
  "min_firmware": "1.3.0",
  "title": "Flight Instruments",
  "description": "Read-only simulated cockpit gauges using normalized telemetry from Host Agent.",
  "category": "TELEMETRY",
  "entry_view": "flight_instruments",
  "permissions": [
    "ui.basic",
    "host.telemetry.read"
  ],
  "required_permissions": [
    "host.telemetry.read"
  ],
  "usb": {
    "mode": "static_superset",
    "requires": []
  },
  "host": {
    "requires": [
      "telemetry.sim"
    ]
  },
  "limits": {
    "max_events_per_sec": 30,
    "max_memory_kib": 256
  }
}
