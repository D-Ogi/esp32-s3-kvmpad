{
  "version": 1,
  "sources": [],
  "state": [
    {
      "id": "capture_mode",
      "type": "string",
      "initial": "OVERVIEW"
    }
  ],
  "connections": [],
  "actions": [
    {
      "id": "set_mode_overview",
