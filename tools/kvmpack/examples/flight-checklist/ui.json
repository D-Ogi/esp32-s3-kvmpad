        "props": {
          "label": "Mark complete"
        },
        "events": {
          "tap": "mark_complete"
        }
      },
      {
        "id": "reset",
        "type": "Button",
        "bounds": {
          "x": 344,
          "y": 264,
          "w": 200,
          "h": 70
        },
        "props": {
          "label": "Reset"
        },
        "events": {
          "tap": "mark_pending"
