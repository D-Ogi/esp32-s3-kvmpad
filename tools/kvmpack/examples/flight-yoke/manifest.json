{
  "schema_version": 1,
  "id": "org.kvmpad.flight.yoke",
  "version": "1.0.0",
  "min_firmware": "1.3.0",
  "title": "Flight Yoke",
  "description": "Pitch, roll, yaw and throttle controls with brake, flaps and an eight-way POV hat.",
  "category": "CONTROL",
  "entry_view": "flight_yoke",
  "permissions": [
    "ui.basic",
    "hid.joystick"
  ],
  "required_permissions": [
    "hid.joystick"
  ],
  "usb": {
    "mode": "static_superset",
    "requires": [
      "hid.joystick"
    ]
  },
  "host": {
    "requires": []
  },
  "limits": {
    "max_events_per_sec": 100,
    "max_memory_kib": 128
  }
}
