{
  "version": 1,
  "root": {
    "id": "panel",
    "type": "Column",
    "bounds": {
      "x": 0,
      "y": 0,
      "w": 360,
      "h": 250
    },
    "children": [
      {
        "id": "altitude_label",
        "type": "Text",
        "bounds": {
          "x": 84,
          "y": 8,
          "w": 256,
          "h": 44
        },
        "props": {
          "text": "Selected altitude (ft)"
        }
      },
      {
        "id": "altitude_value",
        "type": "Text",
        "bounds": {
          "x": 84,
          "y": 60,
          "w": 256,
          "h": 64
        },
        "props": {
          "text": "1000"
        }
      },
      {
        "id": "wheel",
        "type": "RateSlider",
        "bounds": {
          "x": 12,
          "y": 12,
          "w": 64,
          "h": 160
        },
        "events": {
          "step_up": "increase",
          "step_down": "decrease"
        }
      },
      {
        "id": "down_large",
        "type": "Button",
        "bounds": {
          "x": 8,
          "y": 184,
          "w": 80,
          "h": 52
        },
        "props": {
          "label": "-1000"
        },
        "events": {
          "tap": "down_large"
        }
      },
      {
        "id": "down_small",
        "type": "Button",
        "bounds": {
          "x": 94,
          "y": 184,
          "w": 80,
          "h": 52
        },
        "props": {
          "label": "-100"
        },
        "events": {
          "tap": "down_small"
        }
      },
      {
        "id": "up_small",
        "type": "Button",
        "bounds": {
          "x": 180,
          "y": 184,
          "w": 80,
          "h": 52
        },
        "props": {
          "label": "+100"
        },
        "events": {
          "tap": "up_small"
        }
      },
      {
        "id": "up_large",
        "type": "Button",
        "bounds": {
          "x": 266,
          "y": 184,
          "w": 80,
          "h": 52
        },
        "props": {
          "label": "+1000"
        },
        "events": {
          "tap": "up_large"
        }
      }
    ]
  }
}
