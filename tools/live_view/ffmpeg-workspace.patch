+    av_buffer_unref(&pic->motion_val_buf[1]);
+    pic->motion_val_buf[1] = vectors;
+    pic->motion_val[1] = h->cur_pic.motion_val[1] = (int16_t (*)[2])vectors->data + 4;
+    return 0;
